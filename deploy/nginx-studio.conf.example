# Public preview. Define this once in nginx's `http {}` context:
# limit_req_zone $binary_remote_addr zone=opendesign_studio_public:10m rate=30r/m;
#
# Studio remains an isolated loopback service. Anonymous projects are scoped by
# an HttpOnly signed cookie; nginx must preserve Set-Cookie from the upstream.
location = /studio { return 302 /studio/; }

location ^~ /studio/ {
    alias /var/www/opendesign.cc/studio/;
    try_files $uri $uri/ /studio/index.html;
    add_header Cache-Control "no-cache, must-revalidate" always;
}

location ^~ /api/ {
    limit_req zone=opendesign_studio_public burst=20 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:8794;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_hide_header X-Powered-By;
    proxy_read_timeout 60s;
    client_max_body_size 6m;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
}
