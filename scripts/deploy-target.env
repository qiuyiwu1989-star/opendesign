# 部署目标 —— 唯一事实来源。
#
# 为什么单独抽一个文件：2026-08 迁到新服务器后，deploy.sh / upgrade-pack.sh /
# extract-packs-server.sh / initial-setup.sh / configure-redirect.sh 五个脚本
# 各自硬编码着旧 IP 43.159.171.3，迁完谁也没改。旧机器已经不可达，
# 这些脚本此后只会静默超时——下一次迁移必然再犯一遍。
#
# 所以：改机器只改这一个文件。各脚本 source 它，且仍尊重环境变量覆盖
# （DEPLOY_HOST=x.x.x.x ./scripts/deploy.sh 依然管用，方便临时打到别的机器）。

DEPLOY_USER="${DEPLOY_USER:-ubuntu}"
DEPLOY_HOST="${DEPLOY_HOST:-146.56.239.22}"
DEPLOY_PATH="${DEPLOY_PATH:-/var/www/opendesign.cc}"
DEPLOY_URL="${DEPLOY_URL:-https://opendesign.cc}"

# 服务器上的仓库副本（管线脚本在这里跑）
REMOTE_REPO="${REMOTE_REPO:-/home/ubuntu/opendesign}"
