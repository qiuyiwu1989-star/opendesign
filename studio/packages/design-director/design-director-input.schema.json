{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendesign.cc/schemas/studio/design-director-input-0.1.0.json",
  "title": "OpenDesign Design Director Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["inputVersion", "taskId", "title", "brief", "content", "sources", "brand", "deliverable", "designPack", "editability"],
  "properties": {
    "inputVersion": { "const": "0.1.0" },
    "taskId": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "audience"],
      "properties": {
        "objective": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "audience": { "type": "string", "minLength": 1, "maxLength": 300 },
        "decisionRequest": { "type": "string", "minLength": 1, "maxLength": 500 },
        "constraints": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 300 } }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "keyPoints"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "keyPoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text", "sourceIds"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
            }
          }
        },
        "callToAction": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "type", "title", "content"],
        "properties": {
          "sourceId": { "$ref": "#/$defs/id" },
          "type": { "enum": ["article", "brief", "document", "url", "manual", "generated"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 300 },
          "sourceRef": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "content": { "type": "string", "minLength": 1, "maxLength": 12000 },
          "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tone"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "tone": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 50 } },
        "primaryColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "logoAssetSrc": { "type": "string", "pattern": "^asset://[A-Za-z][A-Za-z0-9_./-]*$" }
      }
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "audience", "language", "format", "pageCount"],
      "properties": {
        "kind": { "enum": ["proposal", "keynote", "article-graphics"] },
        "audience": { "type": "string", "minLength": 1, "maxLength": 300 },
        "language": { "enum": ["zh-CN", "en"] },
        "format": { "const": "structured-html" },
        "pageCount": { "type": "integer", "minimum": 6, "maximum": 10 }
      }
    },
    "designPack": { "$ref": "#/$defs/designPackPin" },
    "editability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredCapabilities", "requireNativeText", "requireReplaceableImages", "requireReorderablePages"],
      "properties": {
        "requiredCapabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["text", "typography", "asset", "frame", "order"] }
        },
        "requireNativeText": { "type": "boolean" },
        "requireReplaceableImages": { "type": "boolean" },
        "requireReorderablePages": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,47}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "designPackPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/version" } }
    }
  }
}
