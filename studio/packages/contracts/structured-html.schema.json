{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendesign.cc/schemas/studio/structured-html-0.1.0.json",
  "title": "OpenDesign Structured HTML Manifest",
  "description": "Declarative metadata extracted from untrusted HTML. Executable markup is intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "documentId", "title", "canvas", "designPack", "provenance", "scenes"],
  "properties": {
    "contractVersion": { "const": "0.1.0" },
    "documentId": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "unit"],
      "properties": {
        "width": { "const": 1600 },
        "height": { "const": 900 },
        "unit": { "const": "logical-px" }
      }
    },
    "designPack": { "$ref": "#/$defs/designPackPin" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "scenes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scene" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "designPackPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/version" } }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "generatedBy"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceId", "type", "title"],
            "properties": {
              "sourceId": { "$ref": "#/$defs/id" },
              "type": { "enum": ["article", "brief", "document", "url", "manual", "generated"] },
              "title": { "type": "string", "minLength": 1 },
              "sourceRef": { "type": "string", "minLength": 1 },
              "capturedAt": { "type": "string", "format": "date-time" },
              "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            }
          }
        },
        "generatedBy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "enum": ["skill", "human", "import"] },
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "generatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "exportHint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["html", "pptx"],
      "properties": {
        "html": { "const": "native" },
        "pptx": { "enum": ["native", "raster", "omitted"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tagName", "role", "editableCapabilities", "exportHint", "sourceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "tagName": { "enum": ["h1", "h2", "h3", "p", "span", "img", "div", "figure", "blockquote"] },
        "role": { "enum": ["eyebrow", "title", "body", "caption", "metric", "quote", "image", "shape"] },
        "editableCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["text", "typography", "asset", "frame", "order"] }
        },
        "exportHint": { "$ref": "#/$defs/exportHint" },
        "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "pageRole", "layout", "elements"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "order": { "type": "integer", "minimum": 1 },
        "pageRole": { "type": "string", "minLength": 1 },
        "layout": { "type": "string", "minLength": 1 },
        "elements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/element" } }
      }
    }
  }
}
