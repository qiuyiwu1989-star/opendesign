{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendesign.cc/schemas/studio/scene-ir-0.1.0.json",
  "title": "OpenDesign Studio Scene IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentId", "title", "canvas", "directions", "selectedDirectionId", "scenes"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "documentId": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "unit"],
      "properties": {
        "width": { "const": 1600 },
        "height": { "const": 900 },
        "unit": { "const": "logical-px" }
      }
    },
    "directions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/direction" }
    },
    "selectedDirectionId": { "$ref": "#/$defs/id" },
    "designPack": { "$ref": "#/$defs/designPackPin" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "scenes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/scene" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "designPackPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "sourceProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "type", "title"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/id" },
        "type": { "enum": ["article", "brief", "document", "url", "manual", "generated"] },
        "title": { "type": "string", "minLength": 1 },
        "sourceRef": { "type": "string", "minLength": 1 },
        "capturedAt": { "type": "string", "format": "date-time" },
        "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "generatedBy"],
      "properties": {
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceProvenance" } },
        "generatedBy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "enum": ["skill", "human", "import"] },
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "generatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1600 },
        "y": { "type": "number", "minimum": 0, "maximum": 900 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1600 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 900 }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background", "surface", "text", "muted", "accent", "line", "fontFamily", "headingFamily"],
      "properties": {
        "background": { "type": "string" },
        "surface": { "type": "string" },
        "text": { "type": "string" },
        "muted": { "type": "string" },
        "accent": { "type": "string" },
        "line": { "type": "string" },
        "fontFamily": { "type": "string" },
        "headingFamily": { "type": "string" }
      }
    },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "stance", "rationale", "referenceSlug", "referenceVersion", "tokens"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "stance": { "enum": ["primary", "alternate"] },
        "rationale": { "type": "string", "minLength": 1 },
        "referenceSlug": { "type": "string", "minLength": 1 },
        "referenceVersion": { "type": "string", "minLength": 1 },
        "tokens": { "$ref": "#/$defs/tokens" }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "role", "frame", "editable"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["text", "image", "shape", "metric", "quote"] },
        "role": { "enum": ["eyebrow", "title", "body", "caption", "metric", "quote", "image", "shape"] },
        "frame": { "$ref": "#/$defs/frame" },
        "content": { "type": "string" },
        "assetSrc": { "type": "string" },
        "alt": { "type": "string" },
        "fill": { "type": "string" },
        "color": { "type": "string" },
        "fontSize": { "type": "number", "minimum": 8, "maximum": 240 },
        "fontWeight": { "type": "integer", "minimum": 100, "maximum": 900 },
        "fontFamily": { "type": "string", "minLength": 1 },
        "lineHeight": { "type": "number", "minimum": 0.5, "maximum": 4 },
        "align": { "enum": ["left", "center", "right"] },
        "imageFit": { "enum": ["contain", "cover", "stretch"] },
        "focalPoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "zIndex": { "type": "integer", "minimum": 0 },
        "editable": { "type": "boolean" },
        "editableCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["text", "typography", "asset", "frame", "order"] }
        },
        "exportHint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["html", "pptx"],
          "properties": {
            "html": { "const": "native" },
            "pptx": { "enum": ["native", "raster", "omitted"] },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "sourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "title", "purpose", "layout", "elements"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "order": { "type": "integer", "minimum": 1, "maximum": 10 },
        "title": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "layout": { "type": "string", "minLength": 1 },
        "elements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/element" } }
      }
    }
  }
}
